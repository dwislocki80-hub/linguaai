# Skopiuj ten plik jako .env i wpisz swój klucz API.
# Pliku .env nigdy nie wrzucaj do repozytorium ani nie wysyłaj nikomu.
OPENAI_API_KEY=sk-wklej swoj klucz API
# Nazwa modelu — sprawdź aktualną listę na platform.openai.com
OPENAI_MODEL=gpt-4o-mini
PORT=3000
# MOCK=1 uruchamia tryb demo bez klucza API (przykładowe fiszki)
MOCK=0
